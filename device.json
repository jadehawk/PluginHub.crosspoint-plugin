{
  "title": "Plugin Hub",
  "description": "Discover, install, and update CrossPoint plugins.",
  "browse": {
    "format": "json",
    "url": "https://raw.githubusercontent.com/jadehawk/PluginHub.crosspoint-plugin/main/catalog.json",
    "items": "plugins",
    "page_size": 16,
    "fields": {
      "title": "title",
      "author": "description",
      "id": "name",
      "version": "version"
    },
    "lists_url": "https://raw.githubusercontent.com/jadehawk/PluginHub.crosspoint-plugin/main/catalog-lists.json"
  },
  "download": {
    "dest_dir": "/.crosspoint/plugins",
    "bundle": {
      "base": "base",
      "files": "files",
      "subdir": "{id}"
    }
  }
}
