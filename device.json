{
  "title": "Plugin Hub",
  "description": "Discover, install, and update CrossPoint plugins.",
  "browse": {
    "format": "json",
    "url": "https://raw.githubusercontent.com/jadehawk/PluginHub.crosspoint-plugin/official-community-catalogs-test/catalog.json",
    "lists": [
      {
        "title": "Official Plugins",
        "url": "https://raw.githubusercontent.com/jadehawk/PluginHub.crosspoint-plugin/official-community-catalogs-test/official-catalog.json"
      },
      {
        "title": "Community Plugins",
        "url": "https://raw.githubusercontent.com/jadehawk/PluginHub.crosspoint-plugin/official-community-catalogs-test/community-catalog.json",
        "notice": {
          "title": "Community Plugins",
          "message": "Community plugins are third-party and not vetted by the CrossPoint team. Install at your own discretion.",
          "confirm": "Continue",
          "cancel": "Go Back"
        }
      }
    ],
    "items": "plugins",
    "page_size": 16,
    "fields": {
      "title": "title",
      "author": "description",
      "id": "name",
      "version": "version"
    }
  },
  "download": {
    "dest_dir": "/.crosspoint/plugins",
    "bundle": {
      "base": "base",
      "files": "files",
      "subdir": "{id}"
    }
  }
}
